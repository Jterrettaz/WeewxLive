## weewx-live : page « mois » (SummaryByMonth) — statistiques et graphiques de tous les
## paramètres pour un mois : archive/month-AAAA-MM.html. Option [LiveJSON] [[archives]] (month).
#set global $a = $livejson_arch
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$livejson_station — $a.label</title>
  <link rel="stylesheet" href="../style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='7' fill='%23eda100'/%3E%3C/svg%3E">
</head>
<body class="detail arch-page" data-base="../">
#include "archive/header.inc"

  <div id="banner" class="banner" role="status" aria-live="polite" hidden></div>

  <main class="page" id="page">
    <section class="page-head">
      <div>
        <h2 id="p-title" class="p-title sr">$a.label</h2>
        <p id="p-last" class="p-last"></p>
      </div>
    </section>
    <div id="sections"></div>
  </main>

  <footer class="foot">Archive weewx — $a.label<span id="gen"></span><span id="mode"></span></footer>

  <div id="tip" class="tip" hidden></div>

  <!-- configuration et données de la période, générées par weewx -->
  <script>window.WEEWX_CONFIG = $livejson_config_inline;</script>
  <script>window.WEEWX_PERIOD = { kind: "month", label: "$a.label", data: $livejson_span };</script>
  <script src="../nav.js"></script>
  <script src="../minichart.js"></script>
  <script src="../detail.js"></script>
  <script src="../archive.js"></script>
</body>
</html>
