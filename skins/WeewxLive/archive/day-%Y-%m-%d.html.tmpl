## weewx-live : page « jour » (SummaryByDay) — tous les panneaux du tableau de bord pour une
## journée : archive/day-AAAA-MM-JJ.html. Option [LiveJSON] [[archives]] (day, days).
#set global $day_page = True
#set global $a = $livejson_arch
<!doctype html>
<html lang="$livejson_lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$livejson_station — $a.label</title>
  <link rel="stylesheet" href="../style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='7' fill='%23eda100'/%3E%3C/svg%3E">
</head>
<body class="day-page" data-base="../">
#include "archive/header.inc"
  <p class="day-note">$lt("Panels", "Today's values: minimum and maximum (with time), charts from 0:00 to 24:00; large values: daily means, prevailing wind of the day (most frequent direction), daily totals")<span id="day-last"></span>.</p>

  <div id="banner" class="banner" role="status" aria-live="polite" hidden></div>

  <div class="grid-tools" role="group" aria-label="$lt("Panels", "Panel display")">
    <button type="button" data-all="compact">$lt("Common", "Collapse all")</button>
    <button type="button" data-all="full">$lt("Common", "Expand all")</button>
  </div>
  <main class="grid">
#include "panels.inc"
  </main>

  <footer class="foot"><span id="src">$lt("Archives", "weewx archive of {label}", label=$a.label)</span><span id="gen"></span><span id="mode"></span></footer>

  <div id="tip" class="tip" hidden></div>

  <!-- configuration et données de la journée, générées par weewx -->
  <script>window.WEEWX_CONFIG = $livejson_config_inline;</script>
  <script>window.WEEWX_DAY = $livejson_day;</script>
  <script src="../i18n.js"></script>
  <script src="../wxtime.js"></script>
  <script src="../nav.js"></script>
  <script src="../minichart.js"></script>
  <script src="../app.js"></script>
  <script src="../archive.js"></script>
</body>
</html>
