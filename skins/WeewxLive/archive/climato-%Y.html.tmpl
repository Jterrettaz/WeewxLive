## weewx-live : tableau climatologique annuel (SummaryByYear) — une ligne par mois, en trois
## tableaux : températures et nombres de jours (gel, sans dégel, forte chaleur), pluie, vent :
## archive/climato-AAAA.html. Option [LiveJSON] [[archives]] (climato).
## Les tableaux sont construits par climato.js à partir des données intégrées (WEEWX_CLIMATO).
#set global $a = $livejson_arch
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$livejson_station — climatologie $a.y</title>
  <link rel="stylesheet" href="../style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='7' fill='%23eda100'/%3E%3C/svg%3E">
</head>
<body class="climato-page" data-base="../">
#include "archive/brand.inc"

  <main class="cm-page">
    <h2 class="cm-title">Climatologie annuelle pour $a.y</h2>
    <p class="cm-sub">#if $livejson_climato_method == "omm"#Valeurs journalières selon les règles horaires de l'OMM (heures UTC)#else#Valeurs journalières de 0 h à 24 h#end if#</p>

    <!-- choix de l'année (climato.js), année précédente / suivante, autres pages de l'année -->
    <form class="cm-bar" id="cm-bar" data-first="$a.first" data-today="$a.today" data-y="$a.y">
      <label class="sr" for="cm-year">Année</label>
      <select id="cm-year">
#for $y in $a.years
        <option value="$y"#if $y == $a.y# selected#end if#>$y</option>
#end for
      </select>
      <button type="submit" class="cm-go">Afficher</button>
#if $a.prevY
      <a class="cm-link" href="climato-${a.prevY}.html" rel="prev">‹ Année précédente</a>
#end if
#if $a.nextY
      <a class="cm-link" href="climato-${a.nextY}.html" rel="next">Année suivante ›</a>
#end if
#if $a.year
      <a class="cm-link" href="year-${a.y}.html">Graphiques de l'année</a>
#end if
      <span class="arch-msg" id="cm-msg" role="status" aria-live="polite"></span>
    </form>

    <div class="cm-wrap" id="cm-wrap"><p class="muted">Chargement des tableaux…</p></div>
  </main>

  <footer class="foot">Archive weewx — climatologie $a.y</footer>

  <!-- configuration et données de l'année, générées par weewx -->
  <script>window.WEEWX_CONFIG = $livejson_config_inline;</script>
  <script>window.WEEWX_CLIMATO = $livejson_climato_year;</script>
  <script src="../wxtime.js"></script>
  <script src="../nav.js"></script>
  <script src="../minichart.js"></script>
  <script src="../climato.js"></script>
</body>
</html>
