## weewx-live — page « meteogram » (textes : fichier de langue, $lt)
<!doctype html>
<html lang="$livejson_lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$lt("Meteogram", "Meteogram")</title>
  <link rel="stylesheet" href="style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='7' fill='%23eda100'/%3E%3C/svg%3E">
</head>
<body class="detail mg-page">
  <header class="top">
    <div class="brand">
      <img class="brand-logo" id="brand-logo" alt="" hidden>
      <div class="brand-text">
        <h1 id="station-name">$lt("Common", "Weather station")</h1>
        <p class="subtitle" id="subtitle">weewx</p>
      </div>
    </div>
  </header>
  <nav id="menu" class="menu" aria-label="$lt("Common", "Pages")"></nav>

  <main class="page" id="page">
    <section class="page-head">
      <div>
        <h2 class="p-title"><span class="sw" style="background:var(--wind)"></span>$lt("Meteogram", "Meteogram")</h2>
        <!-- choix du modèle (meteogram.js), puis source, altitude et heure des données -->
        <div class="mg-bar" id="mg-bar"></div>
        <p id="mg-sub" class="p-last">Open-Meteo</p>
      </div>
    </section>
    <div id="mg-root"><p class="muted">$lt("Meteogram", "Loading meteogram…")</p></div>
  </main>

  <footer class="foot">$lt("Common", "Forecasts by {source}", source='<a href="https://open-meteo.com/" rel="noopener">Open-Meteo.com</a>') (CC BY 4.0)<span id="gen"></span></footer>

  <div id="tip" class="tip" hidden></div>

  <script src="i18n.js"></script>
  <script src="wxtime.js"></script>
  <script src="nav.js"></script>
  <script src="minichart.js"></script>
  <script src="wxicons.js"></script>
  <script src="meteogram.js"></script>
</body>
</html>
