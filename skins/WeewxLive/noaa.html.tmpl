## weewx-live — page « Climatologie → Rapports NOAA » (textes : fichier de langue, $lt)
<!doctype html>
<html lang="$livejson_lang">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>$lt("NOAA", "NOAA reports")</title>
  <link rel="stylesheet" href="style.css">
  <script src="theme.js"></script>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='7' fill='%23eda100'/%3E%3C/svg%3E">
</head>
<body class="detail noaa-page">
  <header class="top">
    <div class="brand">
      <img class="brand-logo" id="brand-logo" alt="" hidden>
      <div class="brand-text">
        <h1 id="station-name">$lt("Common", "Weather station")</h1>
        <p class="subtitle" id="subtitle">weewx</p>
      </div>
    </div>
  </header>
  <nav id="menu" class="menu" aria-label="$lt("Common", "Pages")"></nav>

  <main class="page" id="page">
    <section class="page-head">
      <div>
        <h2 class="p-title">$lt("NOAA", "NOAA reports")</h2>
        <p class="p-last">$lt("NOAA", "Monthly and yearly climatological summaries in the NOAA text format, computed from the station's data.")</p>
      </div>
    </section>
    <section class="card noaa-card">
      <form class="noaa-bar" id="noaa-form" onsubmit="return false">
        <label for="noaa-year">$lt("NOAA", "Year")</label>
        <select id="noaa-year"></select>
        <label for="noaa-month">$lt("NOAA", "Period")</label>
        <select id="noaa-month"></select>
        <a id="noaa-dl" class="noaa-dl" href="#" download>$lt("NOAA", "Download")</a>
      </form>
      <p id="noaa-msg" class="muted" role="status" aria-live="polite">$lt("Common", "Loading…")</p>
      <pre id="noaa-text" class="noaa-text" tabindex="0" hidden></pre>
    </section>
  </main>

  <footer class="foot">$lt("NOAA", "Days from 0:00 to 24:00, station time. Column headings follow the NOAA format (in English).")</footer>

  <script>window.WX_NOAA = $livejson_noaa_index;</script>
  <script src="i18n.js"></script>
  <script src="wxtime.js"></script>
  <script src="nav.js"></script>
  <script src="noaa.js"></script>
</body>
</html>
