## weewx-live : gabarit Cheetah du tableau de bord (généré par weewx à chaque archive)
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
#if $livejson_refresh
  <!-- rechargement complet de la page ([LiveJSON] page_refresh, secondes) -->
  <meta http-equiv="refresh" content="$livejson_refresh">
#end if
  <title>$livejson_station — en direct</title>
  <link rel="stylesheet" href="style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='7' fill='%23eda100'/%3E%3C/svg%3E">
</head>
<body>
  <header class="top">
    <div class="brand">
#if $livejson_logo
      <img class="brand-logo" src="$livejson_logo.src" alt="$livejson_logo.alt" height="$livejson_logo.height" style="height:${livejson_logo.height}px">
#end if
      <div class="brand-text">
        <h1 id="station-name">$livejson_station</h1>
        <p class="subtitle">$livejson_hardware</p>
      </div>
    </div>
    <div class="status">
      <span id="clock" class="clock">--:--:--</span>
      <span id="conn" class="pill pill-off" role="status"><span class="dot"></span><span class="txt">Connexion…</span></span>
      <span id="age" class="age"></span>
    </div>
  </header>
  <nav id="menu" class="menu" aria-label="Pages"></nav>

  <div id="banner" class="banner" role="status" aria-live="polite" hidden></div>

  <div class="grid-tools" id="grid-tools" role="group" aria-label="Affichage du tableau de bord">
    <button type="button" data-all="compact">Tout réduire</button>
    <button type="button" data-all="full">Tout développer</button>
    <button type="button" id="dash-edit" aria-pressed="false" title="Changer l'ordre des cadres du tableau de bord">Réorganiser</button>
  </div>

  <!-- Cadres du tableau de bord, dans l'ordre de [LiveJSON] [[dashboard]] order ; chaque
       visiteur peut ensuite les réorganiser (layout.js, ordre mémorisé par le navigateur) -->
  <div class="dash" id="dash">
#set global $day_page = False
#for $blk in $livejson_dash_order
#if $blk == 'parameters'
  <div class="dash-block" data-block="parameters" data-label="Mesures de la station">
  <main class="grid">
#include "panels.inc"
  </main>
  </div>
#elif $blk == 'astro'
  <div class="dash-block" data-block="astro" data-label="Soleil et Lune">
#include "astro.inc"
  </div>
#elif $blk == 'forecast'
  <div class="dash-block" data-block="forecast" data-label="Prévisions">
#include "forecast.inc"
  </div>
#elif $blk == 'maps'
  <div class="dash-block" data-block="maps" data-label="Radar et satellite">
#include "maps.inc"
  </div>
#elif $blk == 'climate'
  <div class="dash-block" data-block="climate" data-label="Ce jour et ce mois au fil des ans">
#include "climate.inc"
  </div>
#end if
#end for
  </div>
  <!-- ordre choisi par le visiteur : appliqué avant la création des cartes et graphiques -->
  <script src="layout.js"></script>

  <footer class="foot"><span id="src">Temps réel via MQTT · historique weewx</span><span id="gen"></span><span id="mode"></span></footer>

  <div id="tip" class="tip" hidden></div>

  <!-- configuration générée par weewx (évite une requête config.json au chargement) -->
  <script>window.WEEWX_CONFIG = $livejson_config_inline;</script>
  <script src="wxtime.js"></script>
  <script src="nav.js"></script>
  <script src="minichart.js"></script>
  <script src="app.js"></script>
  <script src="astro.js"></script>
  <script src="wxicons.js"></script>
  <script src="extras.js"></script>
  <script src="climate.js"></script>
</body>
</html>
